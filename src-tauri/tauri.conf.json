{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mcpilot",
  "version": "0.1.0",
  "identifier": "com.felipe.mcpilot",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "pnpm --dir src-tauri/mcp-bridge install --frozen-lockfile && pnpm --dir src-tauri/mcp-bridge build && pnpm --dir src-tauri/mcp-bridge package:sidecar",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mcpilot",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/mcp-bridge"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
